#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# pre-commit — Bloqueia commits com segredos expostos
# Instalado via: git config core.hooksPath .githooks
# ─────────────────────────────────────────────────────────────────────────────

RED='\033[0;31m'; YELLOW='\033[1;33m'; NC='\033[0m'

error()   { echo -e "${RED}[SEGURANÇA]${NC} $*" >&2; }
warning() { echo -e "${YELLOW}[AVISO]${NC} $*" >&2; }

BLOCKED=0

# 1. Bloqueia arquivos .env reais (não .env.example)
ENV_FILES=$(git diff --cached --name-only | grep -E '^\.env$|/\.env$|\.env\.(development|production|staging|local|test)$' | grep -v '\.example$')
if [ -n "$ENV_FILES" ]; then
  error "Tentativa de commitar arquivo(s) .env com segredos reais:"
  echo "$ENV_FILES" | sed 's/^/  /' >&2
  error "Use .env.example em vez disso."
  BLOCKED=1
fi

# 2. Padrões de chaves de API conhecidas no diff staged
PATTERNS=(
  # Anthropic
  'sk-ant-[a-zA-Z0-9\-_]{80,}'
  # OpenAI
  'sk-[a-zA-Z0-9]{48}'
  # AWS
  'AKIA[0-9A-Z]{16}'
  # GitHub tokens
  'ghp_[a-zA-Z0-9]{36}'
  'ghs_[a-zA-Z0-9]{36}'
  # Generic high-entropy assignment (chave > 32 chars após = ou :)
  '(API_KEY|SECRET|PASSWORD|TOKEN|PRIVATE_KEY)\s*[=:]\s*['\''"]?[A-Za-z0-9+/\-_]{32,}['\''"]?'
)

STAGED_DIFF=$(git diff --cached -U0 2>/dev/null)

for PATTERN in "${PATTERNS[@]}"; do
  MATCH=$(echo "$STAGED_DIFF" | grep -E "^\+" | grep -vE "^\+\+\+" | grep -oE "$PATTERN" | head -3)
  if [ -n "$MATCH" ]; then
    error "Possível segredo detectado (padrão: $(echo "$PATTERN" | cut -c1-40)...)"
    echo "$MATCH" | sed 's/./*/g' | sed 's/^/  Valor ofuscado: /' >&2
    BLOCKED=1
  fi
done

# 3. Aviso se arquivos grandes forem adicionados (>5MB)
LARGE=$(git diff --cached --name-only | while read -r f; do
  [ -f "$f" ] && SIZE=$(wc -c < "$f") && [ "$SIZE" -gt 5242880 ] && echo "$f ($(( SIZE / 1024 / 1024 ))MB)"
done)
if [ -n "$LARGE" ]; then
  warning "Arquivo(s) grandes detectados — considere usar Git LFS:"
  echo "$LARGE" | sed 's/^/  /' >&2
fi

if [ "$BLOCKED" -eq 1 ]; then
  error "Commit BLOQUEADO. Corrija os problemas acima antes de commitar."
  echo "" >&2
  echo "  Para pular esta verificação (NÃO recomendado):" >&2
  echo "    git commit --no-verify" >&2
  echo "" >&2
  exit 1
fi

exit 0
