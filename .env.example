# Copie para .env na raiz (Dokploy gera .env a partir do Environment).
VITE_API_BASE=http://localhost:8000
BOOTSTRAP_ON_START=1
BOOTSTRAP_TARGET=sqlite
BOOTSTRAP_STRICT=0
POC_DATABASE_FILE=/data/poc_database.sqlite
# Servidores Firebird distintos (recomendado em produção)
FIREBIRD_HOST_QUESTOR=questor-db.exemplo.local
FIREBIRD_HOST_VULCANO=vulcano-db.exemplo.local
FIREBIRD_HOST=questor-db.exemplo.local
FIREBIRD_PORT=3050
FIREBIRD_USER=sysdba
FIREBIRD_PASSWORD=
DB_PATH_QUESTOR=/caminho/para/QUESTOR.FDB
DB_PATH_VULCANO=/caminho/para/VULCANO.FDB
GOOGLE_APPLICATION_CREDENTIALS=chave_fernando.json
GEMINI_API_KEY=
