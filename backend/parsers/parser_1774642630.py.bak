import pdfplumber
import re
import json
import sys

def parse_money(s: str) -> float:
    """Converts a string with Brazilian money format (e.g., '1.234,56') to a float."""
    try:
        # Remove thousands separator ('.') and replace decimal comma (',') with a dot ('.')
        return float(s.replace('.', '').replace(',', '.'))
    except (ValueError, AttributeError):
        # Return 0.0 for any parsing errors, maintaining robustness
        return 0.0

def extract(pdf_path: str) -> list[dict]:
    """
    Extracts payment data from a PDF file using pdfplumber and regex.

    Args:
        pdf_path: The path to the PDF file.

    Returns:
        A list of dictionaries, where each dictionary represents a payment record.
    """
    records = []
    
    # Regex patterns for validation and extraction
    date_pattern = re.compile(r'^\d{2}/\d{2}/\d{4}$', re.IGNORECASE)
    # Matches 'XX/YYPM' or 'XX/YYPS' (e.g., '13/42PM', '2/6PS')
    parcela_pattern = re.compile(r'(\d+/\d+(?:PM|PS))', re.IGNORECASE) 
    # Removes content like '(379)' or ' - (486.833.619-34)' from buyer names
    comprador_clean_pattern = re.compile(r'\s*\([^)]*\)|\s*-\s*\([^)]*\)')

    with pdfplumber.open(pdf_path) as pdf:
        for page in pdf.pages:
            # OBRIGATÓRIO: você DEVE tratar text = page.extract_text(layout=True) or ""
            text = page.extract_text(layout=True) or ""
            lines = text.split('\n')

            for line in lines:
                try:
                    line_stripped = line.strip()
                    
                    # 2. Pule linhas em branco vazias ou cabeçalhos.
                    if not line_stripped:
                        continue
                    
                    # Skip common header/footer/summary lines
                    if any(s in line_stripped for s in ["Dt. baixa Cliente", "Total do dia", 
                                                         "Contas Recebidas", "Empresa1", 
                                                         "Centro de custo", "Período de recebimento",
                                                         "ColunaPadrão"]):
                        continue
                    
                    # 3. As colunas são perfeitamente separadas por 2 ou mais espaços.
                    # A instrução solicitou `re.split(r'\s(2,)', line.strip())`, que é uma regex inválida.
                    # Utilizando a regex corrigida `\s{2,}` para '2 ou mais espaços'.
                    colunas = [c.strip() for c in re.split(r'\s{2,}', line_stripped) if c.strip()]
                    
                    if not colunas: # Skip if line yields no columns
                        continue

                    # 4. Use condicionais simples: se len(colunas) < N ou se não houver formato de data \d2/\d2/\d4 em colunas[0], pule a linha (continue).
                    # O prompt sugeriu `len(colunas) < 4`, mas para acessar `colunas[-6]` com segurança, precisamos de pelo menos 6 elementos.
                    # Priorizando a robustez do acesso aos índices.
                    if len(colunas) < 6 or not date_pattern.match(colunas[0]):
                        continue

                    # 5. A coluna da data costuma ser colunas[0]. O nome costuma ser colunas[1].
                    data = colunas[0]
                    
                    # Clean comprador name
                    comprador_raw = colunas[1]
                    comprador = comprador_clean_pattern.sub('', comprador_raw).strip()
                    
                    # 6. Encontre a Parcela iterando na lista de colunas
                    parcela = ""
                    # Search for parcela from the third column onwards (after date and comprador)
                    # This makes it flexible if there are extra fields between comprador and parcela
                    for i in range(2, len(colunas)): 
                        match = parcela_pattern.search(colunas[i])
                        if match:
                            parcela = match.group(1)
                            break
                    
                    if not parcela: # If no parcela found, it's likely not a data record
                        continue

                    # 7. Os últimos itens da lista colunas serão invariavelmente os valores monetários reais.
                    # Agarre os 3 ou 4 últimos índices... Ex: total_pago = parse_money(colunas[-1]).
                    # Baseado na estrutura da amostra de texto bruta fornecida:
                    # 'Vl. baixa', 'Acréscimo', 'Seguro', 'Taxa adm', 'Desconto', 'Líquido'
                    # que mapeia para colunas[-6], colunas[-5], colunas[-4], colunas[-3], colunas[-2], colunas[-1]
                    # Precisamos de: valor_parcela (Vl. baixa), total_pago (Líquido), desconto, acrescimo
                    
                    total_pago = parse_money(colunas[-1])
                    desconto = parse_money(colunas[-2])
                    acrescimo = parse_money(colunas[-5]) 
                    valor_parcela = parse_money(colunas[-6]) 

                    record = {
                        "comprador": comprador,
                        "data": data,
                        "parcela": parcela,
                        "valor_parcela": valor_parcela,
                        "total_pago": total_pago,
                        "desconto": desconto,
                        "acrescimo": acrescimo
                    }
                    records.append(record)

                except Exception:
                    # 8. OBRIGATÓRIO: ENVOLVA A LÓGICA DE CADA LINHA EM UM try/except Exception: continue
                    # Isso garante que uma linha malformada não trave todo o processo de extração.
                    continue 

    return records

if __name__ == "__main__":
    # Certifique-se de que sys e json estejam disponíveis para este bloco, conforme solicitado no prompt.
    if len(sys.argv) < 2:
        # Fornece instruções de uso se nenhum caminho de PDF for fornecido.
        print("Usage: python your_script_name.py <pdf_path>", file=sys.stderr)
        sys.exit(1)
    
    pdf_path = sys.argv[1]
    extracted_data = extract(pdf_path)
    # Imprime os dados extraídos como um array JSON, sem escapar caracteres não-ASCII.
    print(json.dumps(extracted_data, ensure_ascii=False))