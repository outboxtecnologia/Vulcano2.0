GEMINI_API_KEY=
# Vertex AI — coloque o JSON no disco em backend/chave_fernando.json (local) = /app/chave_fernando.json (Docker).
# No .env use só o nome do arquivo; caminhos relativos são sempre em relação à pasta backend:
GOOGLE_APPLICATION_CREDENTIALS=chave_fernando.json
# Opcional outro nome:
# GEMINI_CREDENTIALS_FILE=outra-conta.json
# VERTEX_PROJECT_ID=meu-projeto-gcp
# VERTEX_LOCATION=us-central1

# Modelo (ex.: gemini-2.0-flash, gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.0-flash
# Timeout só da rota /api/extract-pdf com Gemini (segundos)
# GEMINI_EXTRACT_TIMEOUT_SEC=300

# Firebird — caminhos absolutos no SERVIDOR Firebird (não no PC da API)
# DB_PATH_VULCANO=/caminho/VULCANO.FDB
# DB_PATH_QUESTOR=/caminho/QUESTOR.FDB
# FIREBIRD_HOST=127.0.0.1
# Se Questor e Vulcano estiverem em servidores diferentes:
# FIREBIRD_HOST_QUESTOR=192.168.1.10
# FIREBIRD_HOST_VULCANO=192.168.1.11
# FIREBIRD_PORT=3050
# FIREBIRD_USER=SYSDBA
# FIREBIRD_PASSWORD=masterkey

# SQLite POC — opcional; no Docker o compose define /data/poc_database.sqlite
# POC_DATABASE_FILE=/data/poc_database.sqlite
