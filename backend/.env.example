GEMINI_API_KEY=
# Vertex AI — coloque o JSON no disco em backend/chave_fernando.json (local) = /app/chave_fernando.json (Docker).
# No .env use só o nome do arquivo; caminhos relativos são sempre em relação à pasta backend:
GOOGLE_APPLICATION_CREDENTIALS=chave_fernando.json
# Opcional outro nome:
# GEMINI_CREDENTIALS_FILE=outra-conta.json
# VERTEX_PROJECT_ID=meu-projeto-gcp
# VERTEX_LOCATION=us-central1

# Modelo (ex.: gemini-2.0-flash, gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.0-flash
# Timeout só da rota /api/extract-pdf com Gemini (segundos)
# GEMINI_EXTRACT_TIMEOUT_SEC=300

# ===== Questor: backend Firebird OU Postgres (migrado p/ PG em 2026-07) =====
# QUESTOR_DB_KIND=postgres  -> banco `questor` via psycopg (queries FB traduzidas em db_pg.py)
# QUESTOR_DB_KIND=firebird  -> comportamento antigo (Firebird). Default: firebird.
# QUESTOR_DB_KIND=postgres
# QUESTOR_PG_HOST=192.168.16.242
# QUESTOR_PG_PORT=5432
# QUESTOR_PG_DB=questor
# QUESTOR_PG_USER=sigra_gravacao
# QUESTOR_PG_PASS=troque_aqui
# (o banco `vulcano` SEMPRE segue Firebird, independente do KIND acima)

# Firebird — caminhos absolutos no SERVIDOR onde o .fdb está (não no PC da API)
# FIREBIRD_HOST_QUESTOR=192.168.16.158
# FIREBIRD_HOST_VULCANO=192.168.16.164
# DB_PATH_QUESTOR=/Dados/base-oficial/nQuestor.FDB
# DB_PATH_VULCANO=/Klaus/ArquivoQuestor.fdb
# FIREBIRD_PORT=3050
# FIREBIRD_USER=sysdba
# FIREBIRD_PASSWORD=

# SQLite POC — opcional; no Docker o compose define /data/poc_database.sqlite
# POC_DATABASE_FILE=/data/poc_database.sqlite
