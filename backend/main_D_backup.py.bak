@app.get("/api/tables")
def get_tables(db: str = "questor"):
    conn = get_conn(db)
    cur = conn.cursor()
    cur.execute("SELECT RDB$RELATION_NAME FROM RDB$RELATIONS WHERE RDB$SYSTEM_FLAG=0 ORDER BY RDB$RELATION_NAME")
    tables = [row[0].strip() for row in cur.fetchall()]
    conn.close()
    return {"tables": tables}

